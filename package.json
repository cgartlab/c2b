{
  "name": "c2b",
  "version": "1.0.0",
  "description": "C2B (Cam To Background) — 把摄像头实时画面作为 Windows 桌面背景，GPU 硬件加速，带设置界面与屏幕录制",
  "type": "module",
  "bin": { "c2b": "src/cli.js" },
  "main": "src/index.js",
  "scripts": {
    "start": "node src/cli.js start",
    "start:no-ui": "node src/cli.js start --no-ui",
    "status": "node src/cli.js status",
    "stop": "node src/cli.js stop",
    "devices": "node src/cli.js devices",
    "record": "node src/cli.js record",
    "probe": "node src/cli.js probe",
    "test": "node --test --experimental-test-isolation=none \"test/*.test.js\""
  },
  "engines": { "node": ">=20" },
  "dependencies": {},
  "keywords": ["wallpaper", "webcam", "windows", "gpu", "ffmpeg", "mpv", "workerw", "screen-recorder"],
  "license": "MIT",
  "private": true
}